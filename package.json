{
  "name": "bonds-global-web",
  "version": "2.0.0",
  "description": "Bonds Global — Restaurant Profitability SaaS Platform",
  "private": true,
  "scripts": {
    "dev": "vercel dev",
    "dev:local": "node scripts/dev-server.js",
    "deploy": "vercel --prod",
    "test": "jest",
    "test:visual": "node tests/visual/visual-tests.js",
    "test:visual:update": "node tests/visual/visual-tests.js --update",
    "test:a11y": "node tests/a11y/a11y-tests.js",
    "test:mobile": "node tests/mobile/mobile-tests.js",
    "audit": "node scripts/site-audit.js",
    "audit:migrations": "node scripts/verify-migrations.js",
    "audit:og": "node scripts/og-audit.js",
    "audit:i18n": "node scripts/i18n-audit.js",
    "audit:api": "node scripts/api-auth-audit.js",
    "install-hooks": "node scripts/install-hooks.js",
    "setup:supabase": "node scripts/setup-supabase.js",
    "setup:stripe": "node scripts/setup-stripe.js",
    "regenerate:platforms": "node scripts/extract-platform-data.js",
    "regenerate:geo": "node scripts/update-geo-from-geonames.js && node scripts/extract-geo-data.js",
    "regenerate:geo-chunks": "node scripts/extract-geo-data.js",
    "regenerate:calculator-status": "node scripts/generate-calculator-status.js",
    "bump:cache": "node scripts/bump-cache-version.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:search-index": "node scripts/generate-search-index.js",
    "apply:dynamic-og": "node scripts/apply-dynamic-og.js && node scripts/encode-og-image-amps.js",
    "apply:structured-data": "node scripts/apply-structured-data.js",
    "apply:organization-schema": "node scripts/apply-organization-schema.js",
    "apply:hreflang": "node scripts/apply-hreflang.js"
  },
  "dependencies": {
    "@sentry/node": "^10.57.0",
    "@supabase/supabase-js": "^2.108.2",
    "mammoth": "^1.12.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.61.1",
    "resend": "^6.17.1",
    "stripe": "^15.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "bidi-shaper": "^0.1.2",
    "jest": "^30.4.2",
    "pg": "^8.21.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.61.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.3",
    "twemoji": "^14.0.2",
    "vercel": "^56.3.2"
  },
  "overrides": {
    "@tootallnate/once": "^2.0.1",
    "ajv": "^8.17.2",
    "js-yaml": "^4.1.2",
    "minimatch": "^10.2.5",
    "path-to-regexp": "^6.3.0",
    "smol-toml": "^1.6.1",
    "tar": "^7.5.20",
    "undici": "^6.27.0"
  },
  "engines": {
    "node": "24.x"
  }
