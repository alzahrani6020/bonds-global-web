{
  "schema_version": 1,
  "service_code": "web-research",
  "version": 2,
  "enabled": true,
  "governance": {
    "permissions": [],
    "entitlements": [
      "research.web"
    ],
    "feature_flags": [
      {
        "key": "service.web-research.enabled",
        "default_enabled": true
      }
    ]
  },
  "security": {
    "network_access": "public_only",
    "privileges": {
      "service_role": false,
      "private_network": false,
      "arbitrary_code": false,
      "external_write": false,
      "ai_tool_exposure": false
    }
  },
  "observability": {
    "health_check": true,
    "audit": true,
    "metrics": true
  },
  "data": {
    "provenance": true,
    "quality": true
  },
  "workflows": {
    "events": [
      "research.completed"
    ]
  },
  "ai": {
    "exposed": false
  },
  "capabilities": [
    {
      "action": "web_search",
      "action_type": "api",
      "id": "BONDS-CAP-WEB-000",
      "purpose": "Search the public web from a free-text query and return bounded result URLs and snippets for governed follow-up acquisition.",
      "side_effect": "network_read",
      "required": [
        "query"
      ],
      "runtime": {
        "adapter": "web_search"
      }
    },
    {
      "action": "web_fetch",
      "action_type": "api",
      "id": "BONDS-CAP-WEB-001",
      "purpose": "Fetch one public HTTP/HTTPS resource with SSRF protection and evidence hashing.",
      "side_effect": "network_read",
      "required": [
        "url"
      ],
      "runtime": {
        "adapter": "web_fetch"
      }
    },
    {
      "action": "web_crawl",
      "action_type": "api",
      "id": "BONDS-CAP-WEB-002",
      "purpose": "Run a bounded multi-page crawl with host/depth/page budgets.",
      "side_effect": "network_read",
      "required_any": [
        [
          "url",
          "seedUrls",
          "seed_urls"
        ]
      ],
      "runtime": {
        "adapter": "web_crawl"
      }
    },
    {
      "action": "web_explore",
      "action_type": "api",
      "id": "BONDS-CAP-WEB-003",
      "purpose": "Fetch, crawl and extract evidence-bearing content.",
      "side_effect": "network_read",
      "required_any": [
        [
          "url",
          "seedUrls",
          "seed_urls"
        ]
      ],
      "runtime": {
        "adapter": "web_explore"
      }
    },
    {
      "action": "evidence_verify",
      "action_type": "engine",
      "id": "BONDS-CAP-RSCH-001",
      "purpose": "Verify evidence, independence and contradictions.",
      "side_effect": "none",
      "required": [
        "sources"
      ],
      "runtime": {
        "adapter": "evidence_verify"
      }
    },
    {
      "action": "bonds_answer_brief",
      "action_type": "engine",
      "id": "BONDS-CAP-BRIEF-001",
      "purpose": "Bonds-owned page brief. Rank the page, extract the lead sentence, and keep conflicts and open questions.",
      "side_effect": "compute",
      "required": [
        "topic"
      ],
      "runtime": {
        "adapter": "bonds_answer_brief"
      }
    },
    {
      "action": "research_synthesize",
      "action_type": "engine",
      "id": "BONDS-CAP-RSCH-002",
      "purpose": "Synthesize verified research while preserving provenance.",
      "side_effect": "none",
      "required": [
        "sources"
      ],
      "runtime": {
        "adapter": "research_synthesize"
      }
    }
  ]
}
