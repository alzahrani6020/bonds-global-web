{
  "issuer": "bonds-token-service",
  "contractVersion": 2,
  "schemaVersion": 3,
  "serviceTokenTtlSeconds": 3600,
  "requiredClaims": [
    "iss",
    "aud",
    "sub",
    "iat",
    "exp",
    "jti"
  ],
  "introspectionClaims": [
    "iss",
    "aud",
    "sub",
    "iat",
    "exp",
    "jti",
    "scope",
    "active",
    "revoked",
    "token_type"
  ],
  "broker": {
    "auth": "required",
    "mode": "one_time_service_tokens",
    "issuePath": "/broker/issue",
    "revokePath": "/broker/revoke"
  },
  "invariants": {
    "serviceTokenLifetimeSeconds": 3600,
    "legacyTokensWithoutIatOrJtiAreActive": false,
    "revokedTokensAreActive": false,
    "brokerIssuedTokensAreSingleUse": true,
    "adminCredentialAcceptedByBroker": false,
    "channelCredentialAcceptedByBroker": false
  }
}
