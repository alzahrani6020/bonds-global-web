{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/pro",
      "destination": "/pro/index.html"
    },
    {
      "source": "/pro/",
      "destination": "/pro/index.html"
    },
    {
      "source": "/api/pro",
      "destination": "/api/pro"
    },
    {
      "source": "/api/pro/",
      "destination": "/api/pro"
    },
    {
      "source": "/api/force-reset",
      "destination": "/api/admin?action=force-reset"
    },
    {
      "source": "/api/force-reset/",
      "destination": "/api/admin?action=force-reset"
    },
    {
      "source": "/api/reset-password",
      "destination": "/api/admin?action=reset-password"
    },
    {
      "source": "/api/reset-password/",
      "destination": "/api/admin?action=reset-password"
    },
    {
      "source": "/api/v3",
      "destination": "/api/v3/index"
    },
    {
      "source": "/api/v3/billing/webhook",
      "destination": "/api/billing?action=v3-stripe-webhook"
    },
    {
      "source": "/api/v3/billing/webhook/",
      "destination": "/api/billing?action=v3-stripe-webhook"
    },
    {
      "source": "/api/v3/(.*)",
      "destination": "/api/v3/index"
    },
    {
      "source": "/api/analyze-feasibility-v2",
      "destination": "/api/analyze-feasibility"
    },
    {
      "source": "/api/track",
      "destination": "/api/site?action=usage"
    },
    {
      "source": "/api/track/",
      "destination": "/api/site?action=usage"
    },
    {
      "source": "/api/moyasar-checkout",
      "destination": "/api/moyasar?action=checkout"
    },
    {
      "source": "/api/moyasar-verify",
      "destination": "/api/moyasar?action=verify"
    },
    {
      "source": "/api/moyasar-webhook",
      "destination": "/api/moyasar?action=webhook"
    },
    {
      "source": "/api/nps-check",
      "destination": "/api/nps?action=check"
    },
    {
      "source": "/api/nps-submit",
      "destination": "/api/nps?action=submit"
    },
    {
      "source": "/api/send-nps",
      "destination": "/api/nps?action=send"
    },
    {
      "source": "/api/advisors",
      "destination": "/api/advisors?action=list"
    },
    {
      "source": "/api/advisor-dashboard",
      "destination": "/api/advisors?action=dashboard"
    },
    {
      "source": "/api/advisor-update-review",
      "destination": "/api/advisors?action=update-review"
    },
    {
      "source": "/api/funding-readiness",
      "destination": "/api/funding?action=funding-readiness"
    },
    {
      "source": "/api/funding-readiness/",
      "destination": "/api/funding?action=funding-readiness"
    },
    {
      "source": "/api/bank-partner-request",
      "destination": "/api/funding?action=bank-partner-request"
    },
    {
      "source": "/api/bank-partner-request/",
      "destination": "/api/funding?action=bank-partner-request"
    },
    {
      "source": "/api/create-checkout",
      "destination": "/api/checkout?action=create"
    },
    {
      "source": "/api/create-checkout/",
      "destination": "/api/checkout?action=create"
    },
    {
      "source": "/api/create-oneoff-checkout",
      "destination": "/api/checkout?action=oneoff"
    },
    {
      "source": "/api/create-oneoff-checkout/",
      "destination": "/api/checkout?action=oneoff"
    },
    {
      "source": "/api/webhook",
      "destination": "/api/billing?action=stripe-webhook"
    },
    {
      "source": "/api/webhook/",
      "destination": "/api/billing?action=stripe-webhook"
    },
    {
      "source": "/api/bank-transfer",
      "destination": "/api/funding?action=bank-transfer"
    },
    {
      "source": "/api/bank-transfer/",
      "destination": "/api/funding?action=bank-transfer"
    },
    {
      "source": "/api/funding-sources",
      "destination": "/api/funding?action=sources"
    },
    {
      "source": "/api/funding-sources/",
      "destination": "/api/funding?action=sources"
    },
    {
      "source": "/api/contact",
      "destination": "/api/site?action=contact"
    },
    {
      "source": "/api/contact/",
      "destination": "/api/site?action=contact"
    },
    {
      "source": "/api/usage",
      "destination": "/api/site?action=usage"
    },
    {
      "source": "/api/usage/",
      "destination": "/api/site?action=usage"
    },
    {
      "source": "/api/([^/]+)",
      "destination": "/api/$1"
    },
    {
      "source": "/v3/admin",
      "destination": "/v3/admin/index.html"
    },
    {
      "source": "/v3/admin/(.*)",
      "destination": "/v3/admin/index.html"
    },
    {
      "source": "/break-even-explained.html",
      "destination": "/blog/break-even-explained.html"
    },
    {
      "source": "/cash-flow-mistakes.html",
      "destination": "/blog/cash-flow-mistakes.html"
    },
    {
      "source": "/financial-kpis.html",
      "destination": "/blog/financial-kpis.html"
    },
    {
      "source": "/pricing-strategy.html",
      "destination": "/blog/pricing-strategy.html"
    },
    {
      "source": "/tax-zakat-sme.html",
      "destination": "/blog/tax-zakat-sme.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type,Authorization"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|svg|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, no-cache"
        }
      ]
    },
    {
      "source": "/pro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, no-cache"
        }
      ]
    },
    {
      "source": "/api/pro",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, no-cache"
        }
      ]
    },
    {
      "source": "/api/v3/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type,Authorization,x-admin-token"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; img-src 'self' data: https: blob:; connect-src 'self' https:; media-src 'self' https:; frame-src 'self' https://tawk.to https://*.tawk.to; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/v3/cron/calibrate-competitors",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/v3/cron/check-source-quality",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/v3/admin/alerts/evaluate",
      "schedule": "0 8 * * *"
    }
  ]
}
