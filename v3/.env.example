# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin CMS
ADMIN_TOKEN=change-this-to-a-random-strong-string

# Optional: Google Places API for competitor crawling
GOOGLE_PLACES_API_KEY=

# Optional: Geoapify API key for open competitor data
GEOAPIFY_API_KEY=

# Optional: Cron job authentication (Vercel Cron)
CRON_SECRET=change-this-to-a-random-strong-string

# Optional: SMTP settings for source quality email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@bonds-global.com
ALERT_EMAIL_TO=

# Optional: Webhook URL for source quality alerts (Slack/Teams/generic)
SOURCE_QUALITY_ALERT_WEBHOOK_URL=

# HTTP client tuning
HTTP_CLIENT_MAX_RETRIES=3
HTTP_CLIENT_TIMEOUT_MS=15000
# HTTP_PROXY=  # optional

# Optional: OpenAI for LLM-enriched insights
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
