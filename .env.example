# ============================================
# Bonds Global SaaS — Environment Variables
# ============================================
# Copy this file to .env.local for local dev
# Add production values to Vercel Dashboard → Environment Variables
# Never commit real secrets.
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_TAX_RATE_ID=txr_...

# --- Sentry Error Tracking ---
SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx

# --- Moyasar (SADAD / Bank Transfer) ---
MOYASAR_SECRET_KEY=sk_test_... or sk_live_...
MOYASAR_PUBLISHABLE_KEY=pk_test_... or pk_live_...

# --- Bonds Native Inference ---
# Safe local-development defaults. Production values are managed separately.
BONDS_INFERENCE_MODE=LOCAL_NATIVE
BONDS_NATIVE_LOCAL_URL=http://127.0.0.1:8765
BONDS_NATIVE_REMOTE_URL=
BONDS_NATIVE_TIMEOUT_MS=20000
# Keep Bonds analysis native-only unless an explicitly reviewed architecture change enables a fallback.
BONDS_AI_PROVIDER=native-only
BONDS_OPENAI_FALLBACK=false
# Secret: generate/configure out of band. Never commit a real token.
BONDS_NATIVE_TOKEN=

# --- Smart Research Agent ---
GEMINI_API_KEY=your-gemini-key
PEXELS_API_KEY=your-pexels-key
UNSPLASH_ACCESS_KEY=your-unsplash-key
GOOGLE_CSE_KEY=your-cse-key
GOOGLE_CSE_CX=your-cse-cx

# --- OpenAI (other explicitly configured features only) ---
# Keep unset unless a feature is intentionally configured to use OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Bonds V3 Intelligence (optional) ---
GOOGLE_PLACES_API_KEY=
GEOAPIFY_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=https://bonds-global.vercel.app

# --- Email Notifications ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# --- Admin Access ---
ADMIN_EMAIL=admin@example.com
ADMIN_USER_IDS=
ADMIN_EMAILS=admin@example.com

# --- V3 Admin / Cron ---
ADMIN_TOKEN=your-secure-random-token
CRON_SECRET=your-cron-secret

# --- Social Media Integration ---
SOCIAL_FEED_ENABLED=false
SOCIAL_FEED_CACHE_TTL_SECONDS=900
SOCIAL_STORAGE_BUCKET=social-media
SOCIAL_UPLOAD_MAX_BYTES=16777216
SOCIAL_INSTAGRAM_URL=https://instagram.com/bonds.global
SOCIAL_YOUTUBE_URL=https://www.youtube.com/@bondsglobal
SOCIAL_X_URL=https://x.com/bonds_global
SOCIAL_LINKEDIN_URL=https://www.linkedin.com/company/bonds-global

INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_ACCOUNT_ID=your-instagram-business-account-id
INSTAGRAM_APP_ID=your-facebook-app-id
INSTAGRAM_APP_SECRET=your-facebook-app-secret

YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHANNEL_ID=your-channel-id
YOUTUBE_CLIENT_ID=your-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-oauth-client-secret
YOUTUBE_ACCESS_TOKEN=your-oauth-access-token
YOUTUBE_REFRESH_TOKEN=your-oauth-refresh-token

X_BEARER_TOKEN=your-x-bearer-token
X_USERNAME=your-x-username
X_USER_ID=your-x-user-id
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_TOKEN_SECRET=your-x-access-token-secret

# --- Email Notifications (Resend) ---
RESEND_API_KEY=re_...
