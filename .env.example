# ============================================
# Bonds Global SaaS — Environment Variables
# ============================================
# Copy this file to .env.local for local dev
# Add these to Vercel Dashboard → Environment Variables
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Stripe Price IDs (create in Stripe Dashboard) ---
# Pro Plan - Monthly (SAR currency for Saudi market)
STRIPE_PRICE_PRO=price_...
# Enterprise Plan - Monthly (SAR currency for Saudi market)
STRIPE_PRICE_ENTERPRISE=price_...
# Saudi VAT 15% Tax Rate ID (create in Stripe Dashboard → Tax)
STRIPE_TAX_RATE_ID=txr_...

# --- Sentry Error Tracking ---
# Get DSN from: Project Settings → Client Keys (DSN)
SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx

# --- Moyasar (SADAD / Bank Transfer) ---
# Get keys from: https://dashboard.moyasar.com
MOYASAR_SECRET_KEY=sk_test_... or sk_live_...
MOYASAR_PUBLISHABLE_KEY=pk_test_... or pk_live_...

# --- Smart Research Agent ---
# Get free key from https://aistudio.google.com/app/apikey (1500 req/day free)
# This powers the AI analysis of market research results
GEMINI_API_KEY=your-gemini-key
# Pexels API (200 req/hour free) for image search in galleries
# https://www.pexels.com/join-consumer/ then go to API
PEXELS_API_KEY=your-pexels-key
# Optional: Unsplash API (50 req/hour free) fallback for images
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-key
# Optional: Google Custom Search (100 req/day free) for real web search results
# https://programmablesearchengine.google.com/controlpanel/create
GOOGLE_CSE_KEY=your-cse-key
GOOGLE_CSE_CX=your-cse-cx

# --- Bonds V3 Intelligence (optional) ---
# Google Places API key for competitor crawling
# https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=
# Geoapify API key for open competitor data (fallback)
# https://www.geoapify.com/get-started-with-maps-api
GEOAPIFY_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=https://bonds-global.vercel.app

# --- Email Notifications ---
# SMTP settings (e.g. Gmail, SendGrid, Resend, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# --- Admin Access ---
# Primary admin email used as fallback for super_admin verification
ADMIN_EMAIL=admin@example.com
# Comma-separated list of admin Supabase user UUIDs or emails (legacy fallback)
# These emails will receive notifications for new messages & signups
ADMIN_USER_IDS=
ADMIN_EMAILS=admin@example.com

# --- V3 Admin / Cron ---
# Secret token for /api/v3/admin/* and cron endpoints
ADMIN_TOKEN=your-secure-random-token
# Secret used to authorize cron jobs
CRON_SECRET=your-cron-secret

# --- Email Notifications (Resend) ---
RESEND_API_KEY=re_...
