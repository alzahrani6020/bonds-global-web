#!/bin/sh
# Bonds Global — Pre-commit Quality Gate
# Blocks commits when site audit, API auth audit, or critical security regressions fail.

echo ""
echo "🔍 Bonds Global Pre-commit Quality Gate"
echo "======================================="
echo ""

npm run audit:precommit
RESULT=$?

if [ $RESULT -ne 0 ]; then
  echo ""
  echo "❌ Pre-commit quality gate FAILED. Commit blocked."
  echo ""
  echo "Fix the issue above, then try committing again."
  echo "To bypass this check: git commit --no-verify"
  echo "Bypassing is not recommended."
  echo ""
  exit 1
fi

echo ""
echo "✅ Pre-commit quality gate passed."
echo ""
exit 0
